#!/bin/sh

. "$HOME/.config/i3blocks/colors.sh"


if ! command -v wpctl >/dev/null 2>&1
then
    echo "Vol: n/a"
    echo
    echo "$bright_black"
    exit 0
fi

status="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"

if [ -z "$status" ]
then
    echo "Vol: none"
    echo
    echo "$bright_black"
    exit 0
fi

volume="$(printf "%s\n" "$status" | awk '{ print int($2 * 100 + 0.5) }')"

if printf "%s\n" "$status" | grep -q '\[MUTED\]'
then
    echo "Vol: muted"
    echo "mute"
    echo "$bright_black"
    exit 0
fi

echo "Vol: ${volume}%"
echo "${volume}%"
