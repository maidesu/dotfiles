#!/bin/sh

. "$HOME/.config/i3blocks/colors.sh"


iface=""

for path in /sys/class/net/*/wireless
do
    [ -e "$path" ] || continue
    iface="$(basename "$(dirname "$path")")"
    break
done

if [ -z "$iface" ]
then
    echo "W: none"
    echo "W"
    echo "$bright_black"
    exit 0
fi


if command -v nmcli >/dev/null 2>&1
then
    state="$(nmcli -t -f DEVICE,STATE device status | awk -F: -v iface="$iface" '$1 == iface { print $2 }')"

    case "$state" in
        unavailable)
            echo "W: down"
            echo "W"
            echo "$bright_red"
            exit 0
            ;;
        disconnected)
            echo "W: disconnected"
            echo "W"
            echo "$bright_red"
            exit 0
            ;;
        connecting)
            echo "W: connecting"
            echo "W"
            echo "$bright_yellow"
            exit 0
            ;;
        connected)
            ;;
        *)
            ;;
    esac
fi


level="$(
    awk -v iface="$iface:" '
        $1 == iface {
            level = $4
            sub(/\.$/, "", level)
            print level
        }
    ' /proc/net/wireless
)"

if [ -z "$level" ]
then
    echo "W: ?dBm"
    echo "W"
    echo "$bright_magenta"
    exit 0
fi

echo "W: ${level}dBm"
echo "W"

if [ "$level" -ge -60 ]
then
    echo "$bright_green"
elif [ "$level" -ge -70 ]
then
    echo "$bright_yellow"
else
    echo "$bright_magenta"
fi
