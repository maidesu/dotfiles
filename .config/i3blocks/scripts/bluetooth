#!/bin/sh

. "$HOME/.config/i3blocks/colors.sh"


if ! command -v bluetoothctl >/dev/null 2>&1
then
    echo "B: n/a"
    echo "B"
    echo "$bright_black"
    exit 0
fi


show="$(bluetoothctl show 2>/dev/null)"

if [ -z "$show" ]
then
    echo "B: none"
    echo "B"
    echo "$bright_black"
    exit 0
fi


if ! printf "%s\n" "$show" | grep -q "Powered: yes"
then
    echo "B: down"
    echo "B"
    echo "$bright_red"
    exit 0
fi


count="$(bluetoothctl devices Connected 2>/dev/null | awk 'END { print NR }')"

if [ "$count" -gt 0 ]
then
    echo "B: ${count}"
    echo "B"
    echo "$bright_green"
else
    echo "B: up"
    echo "B"
    echo "$bright_yellow"
fi
